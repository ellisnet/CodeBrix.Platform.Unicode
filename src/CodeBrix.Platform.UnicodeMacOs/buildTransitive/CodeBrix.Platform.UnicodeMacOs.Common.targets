<?xml version="1.0" encoding="utf-8"?>
<!--
    Embeds icudt.dat as an EmbeddedResource at consumer build time, when the
    consumer project is a CodeBrix.Platform head ($(IsCodeBrixHead)) and the
    data has not already been included by another package in the same build.

    The $(CodeBrixIcuDataIncluded) sentinel is shared with the sibling
    CodeBrix.Platform.Unicode (Windows) package, so a consumer that references
    both the Windows and macOS Unicode packages still embeds icudt.dat exactly
    once. The TARGET name is distinct from the Windows package's target name so
    a consumer importing both gets no target-redefinition surprise.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="AddCodeBrixPlatformUnicodeMacOsEmbeddedResource"
            BeforeTargets="BeforeBuild;BeforeCompile"
            Condition="'$(IsCodeBrixHead)' == 'true' and '$(CodeBrixIcuDataIncluded)' != 'true'">
        <ItemGroup>
            <EmbeddedResource Include="$(MSBuildThisFileDirectory)icudt.dat" />
        </ItemGroup>
        <PropertyGroup>
            <CodeBrixIcuDataIncluded>true</CodeBrixIcuDataIncluded>
        </PropertyGroup>
    </Target>

</Project>
