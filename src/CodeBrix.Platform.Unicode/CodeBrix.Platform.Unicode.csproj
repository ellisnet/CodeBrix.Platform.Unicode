<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Platform.Unicode</AssemblyName>
    <RootNamespace>CodeBrix.Platform.Unicode</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeContentInPack>true</IncludeContentInPack>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.Platform.Unicode.ApacheLicenseForever</PackageId>
    <Product>CodeBrix.Platform.Unicode</Product>
    <Title>CodeBrix.Platform.Unicode</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A .NET 10 redistribution of the International Components for Unicode (ICU) version 77 native binaries for Windows, packaged for the CodeBrix family. Ships icuuc77.dll + icudt77.dll for win-x64 and win-arm64, the full ICU 77 data archive (icudt.dat), and a buildTransitive .targets pair that delivers the data archive at consumer-build time - embedded as an EmbeddedResource into an application head, or copied beside the application for a host-free consumer such as a test project or a console tool.</Description>
    <PackageLicenseExpression>Apache-2.0 AND Unicode-3.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Platform.Unicode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Platform.Unicode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors. ICU 77 binaries (c) 2016-2025 Unicode, Inc., distributed under the Unicode License Version 3.</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>ICU;Unicode;CLDR;collation;normalization;BiDi;Platform;Windows;native;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png"     Pack="true" PackagePath="" />
    <None Include="..\..\README.md"                  Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt"           Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt"    Pack="true" PackagePath="" />
    <None Include="..\..\UNICODE-LICENSE.txt"        Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\**\*"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="runtimes\win-x64\native\icuuc77.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/icuuc77.dll" />
    <None Include="runtimes\win-x64\native\icudt77.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/icudt77.dll" />
    <None Include="runtimes\win-arm64\native\icuuc77.dll"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/icuuc77.dll" />
    <None Include="runtimes\win-arm64\native\icudt77.dll"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/icudt77.dll" />
  </ItemGroup>

</Project>
